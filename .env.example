# ─── AdmitsOnly — environment variables ───
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit real secrets.

# Database (Postgres) — Prisma reads these
DATABASE_URL=postgresql://user:pass@host:5432/admitsonly
POSTGRES_PRISMA_URL=postgresql://user:pass@host:5432/admitsonly

# NextAuth
NEXTAUTH_SECRET=your-long-random-secret
# NEXTAUTH_URL=https://your-domain.com   # set in production

# Admin registration guard
ADMIN_SECRET_KEY=your-admin-key

# ─── Adam (AI assistant) ───
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (default: claude-haiku-4-5 for both)
# ADAM_MODEL=claude-haiku-4-5
# ADAM_MEMORY_MODEL=claude-haiku-4-5

# ─── PayPal (Essay Samples paywall) ───
# Get SANDBOX credentials at https://developer.paypal.com/dashboard/applications/sandbox
# Use `sandbox` while testing; switch to `live` only after a clean sandbox run.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ─── Optional integrations ───
# RESEND_API_KEY=re_...            # transactional email
# NOTIFICATION_EMAIL=you@example.com
