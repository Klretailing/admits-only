generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student") // student | parent | admin
  plan      String?  // foundations | scholarship | stem — null = free/no plan
  planStartedAt DateTime?
  lastLoginAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      StudentProfile?
  essays       Essay[]
  podMembers   PodMember[]
  podMessages  PodMessage[]
  motifBoards  MotifBoard[]

  @@map("users")
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  gpa              Float?
  gpaScale         String   @default("4.0")
  satMath          Int?
  satRW            Int?
  extracurriculars Json     @default("[]") // Array of EC objects
  holisticScore    Int?
  percentile       Int?
  gpaScore         Int?
  satScore         Int?
  ecScore          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Essay {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String   @default("")
  content   String   @default("")
  status    String   @default("Draft") // Draft | In Review | Complete
  aiScore       Float?
  vocabScore    Float?
  grammarScore  Float?
  originalityScore Float?
  overallScore  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("essays")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // pageview | click | session | event
  timestamp DateTime
  path      String
  referrer  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@map("analytics_events")
}

model StudyPod {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  PodMember[]
  messages PodMessage[]

  @@map("study_pods")
}

model PodMember {
  id       String   @id @default(cuid())
  podId    String
  userId   String
  role     String   @default("member") // admin | member
  joinedAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@map("pod_members")
}

model PodMessage {
  id        String   @id @default(cuid())
  podId     String
  userId    String
  content   String
  type      String   @default("discussion") // discussion | essay_share | feedback
  essayId   String?
  createdAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pod_messages")
}

model MotifBoard {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled Board")
  bullets   Json     @default("[]")
  analysis  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("motif_boards")
}
