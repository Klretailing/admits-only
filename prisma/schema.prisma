generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student") // student | parent | educator | admin
  plan      String?  // foundations | scholarship | stem — null = free/no plan
  planStartedAt DateTime?
  lastLoginAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            StudentProfile?
  essays             Essay[]
  podMembers         PodMember[]
  podMessages        PodMessage[]
  motifBoards        MotifBoard[]
  agentConversations AgentConversation[]
  agentMemory        AgentMemory?

  // Educator relations
  educatorProfile    EducatorProfile?
  educatorServices   EducatorService[]
  educatorStudents   EducatorStudent[]
  bookings           Booking[]
  manualEarnings     ManualEarning[]

  // Document collaboration
  podDocuments       PodDocument[]
  documentComments   DocumentComment[]

  // Study sessions
  createdSessions    PodStudySession[]    @relation("SessionCreator")
  sessionParticipations SessionParticipant[]

  // Essay library
  uploadedEssayDocs  EssayDocument[]      @relation("EssayDocumentUploader")

  // Essay reviews & session notes
  essayReviewsAsStudent EssayReview[]     @relation("EssayReviewStudent")
  tutorSessionNotes     TutorSessionNote[] @relation("TutorNotes")

  // Engagement features
  messageReactions   PodMessageReaction[]
  createdPolls       PodPoll[]            @relation("PollCreator")
  pollVotes          PodPollVote[]
  podMemberStats     PodMemberStats[]
  podActivities      PodActivity[]

  @@map("users")
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  gpa              Float?
  gpaScale         String   @default("4.0")
  gpaWeighted      Float?
  satMath          Int?
  satRW            Int?
  actScore         Int?
  extracurriculars Json     @default("[]") // Array of EC objects
  holisticScore    Int?
  percentile       Int?
  gpaScore         Int?
  satScore         Int?
  ecScore          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Essay {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String   @default("")
  content   String   @default("")
  status    String   @default("Draft") // Draft | In Review | Complete
  aiScore       Float?
  vocabScore    Float?
  grammarScore  Float?
  originalityScore Float?
  overallScore  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews EssayReview[]

  @@map("essays")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  type       String   // pageview | click | session | event | feature | nav | scroll
  timestamp  DateTime
  path       String
  sessionId  String?
  userId     String?
  referrer   String?
  meta       Json?
  deviceInfo Json?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([sessionId])
  @@index([userId])
  @@map("analytics_events")
}

model StudyPod {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  inviteCode  String   @unique
  kind        String   @default("pod")   // pod | community
  slug        String?  @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       PodMember[]
  messages      PodMessage[]
  documents     PodDocument[]
  studySessions PodStudySession[]
  polls         PodPoll[]
  memberStats   PodMemberStats[]
  activities    PodActivity[]

  @@map("study_pods")
}

model PodMember {
  id       String   @id @default(cuid())
  podId    String
  userId   String
  role     String   @default("member") // admin | member
  joinedAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@map("pod_members")
}

model PodMessage {
  id          String   @id @default(cuid())
  podId       String
  userId      String
  content     String
  type        String   @default("discussion") // discussion | essay_share | feedback | poll
  essayId     String?
  parentId    String?
  reportCount Int      @default(0)
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  pod       StudyPod             @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions PodMessageReaction[]

  @@map("pod_messages")
}

model PodMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message PodMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("pod_message_reactions")
}

model PodPoll {
  id        String    @id @default(cuid())
  podId     String
  creatorId String
  question  String
  options   String    @default("[]")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  pod     StudyPod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  creator User          @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  votes   PodPollVote[]

  @@index([podId])
  @@map("pod_polls")
}

model PodPollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())

  poll PodPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("pod_poll_votes")
}

model PodMemberStats {
  id             String   @id @default(cuid())
  podId          String
  userId         String
  xp             Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String   @default("")
  messagesCount  Int      @default(0)
  sessionsCount  Int      @default(0)
  reactionsGiven Int      @default(0)
  docsShared     Int      @default(0)
  pollsVoted     Int      @default(0)
  achievements   String   @default("[]")
  updatedAt      DateTime @updatedAt

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@map("pod_member_stats")
}

model PodActivity {
  id        String   @id @default(cuid())
  podId     String
  userId    String
  type      String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([podId])
  @@map("pod_activities")
}

model MotifBoard {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled Board")
  bullets   Json     @default("[]")
  analysis  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("motif_boards")
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  facts     Json     @default("[]") // Array of learned facts about the user
  preferences Json   @default("{}") // User preferences and style
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_memories")
}

// ─── Educator Models ───

model EducatorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String   @default("")
  headline         String   @default("") // e.g. "SAT & College Admissions Coach"
  credentials      Json     @default("[]") // Array of { title, institution, year }
  subjects         Json     @default("[]") // Array of speciality strings
  hourlyRate       Float?
  currency         String   @default("USD")
  zoomLink         String   @default("")
  googleMeetLink   String   @default("")
  availability     Json     @default("{}") // { mon: [{start,end}], tue: [...], ... }
  timezone         String   @default("America/New_York")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educator_profiles")
}

model EducatorService {
  id          String   @id @default(cuid())
  educatorId  String
  name        String   // e.g. "SAT Prep Session", "Essay Review"
  description String   @default("")
  duration    Int      @default(60) // minutes
  price       Float
  currency    String   @default("USD")
  type        String   @default("one_on_one") // one_on_one | group | package
  maxStudents Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("educator_services")
}

model EducatorStudent {
  id         String   @id @default(cuid())
  educatorId String
  studentName String
  studentEmail String  @default("")
  tags       Json     @default("[]") // Array of tag strings e.g. ["SAT Prep", "Essay Review"]
  notes      Json     @default("[]") // Array of { id, text, date }
  status     String   @default("active") // active | paused | completed
  startDate  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  educator User      @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([educatorId])
  @@map("educator_students")
}

model Booking {
  id          String   @id @default(cuid())
  educatorId  String
  studentId   String?  // EducatorStudent id
  serviceId   String?  // EducatorService id
  title       String
  date        DateTime
  duration    Int      @default(60) // minutes
  status      String   @default("scheduled") // scheduled | completed | cancelled | no_show
  meetingLink String   @default("")
  platform    String   @default("zoom") // zoom | google_meet | in_person | other
  amount      Float    @default(0)
  paid        Boolean  @default(false)
  notes       String   @default("") // Session notes (educator fills in after session)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  educator User              @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  student  EducatorStudent?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  service  EducatorService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([educatorId, date])
  @@map("bookings")
}

model ManualEarning {
  id          String   @id @default(cuid())
  educatorId  String
  description String
  hours       Float
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  educator User @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
  @@map("manual_earnings")
}

// ─── Pod Document Collaboration ───

model PodDocument {
  id          String   @id @default(cuid())
  podId       String
  uploaderId  String
  fileName    String
  fileType    String   // pdf | doc | docx | txt | image
  fileSize    Int      // bytes
  content     String   @default("") // text content for txt/extracted text
  fileData    String   @default("") // base64-encoded file data for rendering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pod      StudyPod          @relation(fields: [podId], references: [id], onDelete: Cascade)
  uploader User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  comments DocumentComment[]

  @@index([podId])
  @@map("pod_documents")
}

model DocumentComment {
  id          String   @id @default(cuid())
  documentId  String
  userId      String
  content     String
  section     String   @default("") // section/page reference for anchored comments
  parentId    String?  // for threaded replies
  createdAt   DateTime @default(now())

  document PodDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   DocumentComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  DocumentComment[] @relation("CommentThread")

  @@index([documentId])
  @@map("document_comments")
}

// ─── Pod Study Sessions (Pomodoro Focus Rooms) ───

model PodStudySession {
  id            String   @id @default(cuid())
  podId         String
  creatorId     String
  title         String   @default("Focus Session")
  focusDuration Int      @default(25)  // minutes
  breakDuration Int      @default(5)   // minutes
  rounds        Int      @default(4)   // number of pomodoro rounds
  status        String   @default("waiting") // waiting | active | break | completed
  currentRound  Int      @default(0)
  startedAt     DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pod          StudyPod               @relation(fields: [podId], references: [id], onDelete: Cascade)
  creator      User                   @relation("SessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants SessionParticipant[]

  @@index([podId])
  @@map("pod_study_sessions")
}

model SessionParticipant {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  goal        String   @default("") // what they plan to work on
  completed   Boolean  @default(false)
  joinedAt    DateTime @default(now())

  session PodStudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_participants")
}

// ─── Essay Library (Monetizable successful admissions essays) ───

model EssayDocument {
  id              String   @id @default(cuid())
  title           String
  collegeName     String   @default("")
  prompt          String   @default("") // the essay prompt
  content         String   @default("") // the essay text
  fileData        String   @default("") // base64 file data for PDF uploads
  fileType        String   @default("text") // text | pdf
  // Student profile context
  studentGpa      String   @default("")
  studentSat      String   @default("")
  studentState    String   @default("")
  studentECs      String   @default("") // comma-separated extracurriculars
  studentAwards   String   @default("") // comma-separated awards
  // Access control
  isFree          Boolean  @default(true) // free for now, monetize later
  priceInCents    Int      @default(0) // future: price in cents for Stripe
  published       Boolean  @default(true)
  uploadedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  uploadedBy User @relation("EssayDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("essay_documents")
}

// ─── Essay Reviews (tutor review queue) ───

model EssayReview {
  id            String    @id @default(cuid())
  essayId       String
  studentId     String
  tutorId       String?
  status        String    @default("pending") // pending | in_review | completed | returned
  priority      String    @default("normal")
  studentNote   String    @default("")
  tutorFeedback String    @default("")
  annotations   Json      @default("[]")
  scores        Json      @default("{}")
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  essay   Essay @relation(fields: [essayId], references: [id], onDelete: Cascade)
  student User  @relation("EssayReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([tutorId])
  @@index([status])
  @@map("essay_reviews")
}

// ─── Tutor Session Notes ───

model TutorSessionNote {
  id         String   @id @default(cuid())
  educatorId String
  title      String   @default("Untitled")
  content    String   @default("")
  color      String   @default("default")
  pinned     Boolean  @default(false)
  archived   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  educator User @relation("TutorNotes", fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId])
  @@map("tutor_session_notes")
}
