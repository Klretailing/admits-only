generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student") // student | parent | educator | admin
  plan      String?  // foundations | scholarship | stem — null = free/no plan
  planStartedAt DateTime?
  lastLoginAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            StudentProfile?
  essays             Essay[]
  podMembers         PodMember[]
  podMessages        PodMessage[]
  motifBoards        MotifBoard[]
  agentConversations AgentConversation[]
  agentMemory        AgentMemory?

  // Educator relations
  educatorProfile    EducatorProfile?
  educatorServices   EducatorService[]
  educatorStudents   EducatorStudent[]
  bookings           Booking[]

  @@map("users")
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  gpa              Float?
  gpaScale         String   @default("4.0")
  satMath          Int?
  satRW            Int?
  extracurriculars Json     @default("[]") // Array of EC objects
  holisticScore    Int?
  percentile       Int?
  gpaScore         Int?
  satScore         Int?
  ecScore          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Essay {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String   @default("")
  content   String   @default("")
  status    String   @default("Draft") // Draft | In Review | Complete
  aiScore       Float?
  vocabScore    Float?
  grammarScore  Float?
  originalityScore Float?
  overallScore  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("essays")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // pageview | click | session | event
  timestamp DateTime
  path      String
  referrer  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@map("analytics_events")
}

model StudyPod {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  PodMember[]
  messages PodMessage[]

  @@map("study_pods")
}

model PodMember {
  id       String   @id @default(cuid())
  podId    String
  userId   String
  role     String   @default("member") // admin | member
  joinedAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podId, userId])
  @@map("pod_members")
}

model PodMessage {
  id        String   @id @default(cuid())
  podId     String
  userId    String
  content   String
  type      String   @default("discussion") // discussion | essay_share | feedback
  essayId   String?
  createdAt DateTime @default(now())

  pod  StudyPod @relation(fields: [podId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pod_messages")
}

model MotifBoard {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled Board")
  bullets   Json     @default("[]")
  analysis  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("motif_boards")
}

model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentMessage[]

  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("agent_messages")
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  facts     Json     @default("[]") // Array of learned facts about the user
  preferences Json   @default("{}") // User preferences and style
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_memories")
}

// ─── Educator Models ───

model EducatorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String   @default("")
  headline         String   @default("") // e.g. "SAT & College Admissions Coach"
  credentials      Json     @default("[]") // Array of { title, institution, year }
  subjects         Json     @default("[]") // Array of speciality strings
  hourlyRate       Float?
  currency         String   @default("USD")
  zoomLink         String   @default("")
  googleMeetLink   String   @default("")
  availability     Json     @default("{}") // { mon: [{start,end}], tue: [...], ... }
  timezone         String   @default("America/New_York")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educator_profiles")
}

model EducatorService {
  id          String   @id @default(cuid())
  educatorId  String
  name        String   // e.g. "SAT Prep Session", "Essay Review"
  description String   @default("")
  duration    Int      @default(60) // minutes
  price       Float
  currency    String   @default("USD")
  type        String   @default("one_on_one") // one_on_one | group | package
  maxStudents Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("educator_services")
}

model EducatorStudent {
  id         String   @id @default(cuid())
  educatorId String
  studentName String
  studentEmail String  @default("")
  tags       Json     @default("[]") // Array of tag strings e.g. ["SAT Prep", "Essay Review"]
  notes      Json     @default("[]") // Array of { id, text, date }
  status     String   @default("active") // active | paused | completed
  startDate  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  educator User      @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([educatorId])
  @@map("educator_students")
}

model Booking {
  id          String   @id @default(cuid())
  educatorId  String
  studentId   String?  // EducatorStudent id
  serviceId   String?  // EducatorService id
  title       String
  date        DateTime
  duration    Int      @default(60) // minutes
  status      String   @default("scheduled") // scheduled | completed | cancelled | no_show
  meetingLink String   @default("")
  platform    String   @default("zoom") // zoom | google_meet | in_person | other
  amount      Float    @default(0)
  paid        Boolean  @default(false)
  notes       String   @default("") // Session notes (educator fills in after session)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  educator User              @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  student  EducatorStudent?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  service  EducatorService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([educatorId, date])
  @@map("bookings")
}
