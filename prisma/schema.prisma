generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student") // student | parent | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // pageview | click | session | event
  timestamp DateTime
  path      String
  referrer  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@map("analytics_events")
}
